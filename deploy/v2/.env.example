# Use a newly generated hexadecimal value (URL-safe) for this database password.
POSTGRES_PASSWORD=
# Public website (authorized 2026-10-26); preserve the local maintenance tunnel.
PUBLIC_HTTP_PORT=0.0.0.0:80
HTTP_PORT=127.0.0.1:8080
# HTTPS is activated with compose.override.yaml after certificate issuance.
HTTPS_PORT=0.0.0.0:443
ACME_WEBROOT_DIR=/opt/freight-quotes/shared/acme-webroot
LETSENCRYPT_DIR=/etc/letsencrypt
# After copying the intake directory into source-data, set this to /data/sources/manifest.json.
V2_IMPORT_MANIFEST=
V2_PRICE_DRAFTS=
