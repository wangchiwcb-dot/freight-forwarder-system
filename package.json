{
  "name": "zhonghang-freight-quotes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm typecheck && pnpm v2:typecheck && vite build",
    "check": "pnpm typecheck && pnpm v2:typecheck && pnpm test",
    "v2:dev": "tsx server/v2/index.ts",
    "v2:typecheck": "tsc -p tsconfig.server.json",
    "v2:build": "pnpm v2:typecheck && vite build --config vite.server.config.ts && node scripts/v2/copy-runtime.mjs",
    "v2:start": "node dist-server/index.js",
    "v2:package": "pnpm typecheck && pnpm v2:build && node scripts/v2/package-release.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "data:normalize": "node scripts/normalize-quotes.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@tanstack/react-query": "^5.90.0",
    "antd": "^5.29.0",
    "decimal.js": "^10.6.0",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
